<?xml version="1.0" encoding="utf-8"?>
<!--
  The Windows installer: go-fs.exe in Program Files, run by the go-fs service,
  which starts with Windows, and the configuration in ProgramData. Built on
  Windows by the WiX Toolset, for x64:

    wix build packaging/windows/go-fs.wxs -arch x64 -ext WixToolset.Util.wixext
      -ext WixToolset.Firewall.wixext -ext WixToolset.UI.wixext -d Version=0.10.0
      -d Bin=build/pkg/go-fs_windows_amd64.exe -d Config=build/pkg/go-fs.windows.toml
      -o dist/go-fs-0.10.0-x64.msi

  Bin is the binary built with -X main.packaging=msi, and Config the template
  serving C:\ProgramData\go-fs\files, with its container registry in
  C:\ProgramData\go-fs\registry; make msi-inputs builds both.

  The same file builds the msi of go-fs-light, given -d Product=go-fs-light
  and the light binary as Bin:

      -d Product=go-fs-light -d Bin=build/pkg/go-fs-light_windows_amd64.exe
      -o dist/go-fs-light-0.10.0-x64.msi

  It installs to the same folders and as the same service, under an
  UpgradeCode of its own, and each msi removes the other product before it
  installs: only one of them is ever installed. The configuration stays, as
  it does on an update.

  Run interactively, the installer shows a welcome page, a page to start the
  install and a last page whose ticked checkbox opens the admin interface in
  the default browser once Finish is pressed. A quiet install opens nothing.

  Once installed, go-fs updates itself from the GitHub releases, through the
  update page of its admin interface: it puts the .update of the release in
  place of go-fs.exe, keeping the previous one as go-fs.exe.old, and ends the
  service with an error, which the recovery below answers with a restart.

  The msi of a newer release updates as well, run like the first one: the
  major upgrade stops and removes the service of the installed version,
  installs the new one and starts it again. It compares its version with the
  msi installed, not with what go-fs updated itself to, so an msi older than
  the running go-fs puts that older version back. The configuration file is
  never replaced, nor removed by an uninstall: it holds the accounts and the
  keys.

  msiexec /i go-fs-<version>-x64.msi /qn            installs or updates quietly
  msiexec /i go-fs-<version>-x64.msi /qn FIREWALL=1 also opens the firewall
-->
<!-- Product names what is built, go-fs unless given. UpgradeCode is that
     product's for good, OtherUpgradeCode the other product's, which the
     Upgrade below removes; Serves is what its service description lists. -->
<?ifndef Product?>
  <?define Product = go-fs?>
<?endif?>
<?if $(Product) = go-fs?>
  <?define UpgradeCode = 703FFA44-28B3-48C3-AB59-2D180F83AAD9?>
  <?define OtherUpgradeCode = 9E605789-09D0-4960-8BC1-3EFD8753FE84?>
  <?define Serves = FTP, FTPS, SFTP, HTTP, HTTPS, S3 and TFTP?>
<?elseif $(Product) = go-fs-light?>
  <?define UpgradeCode = 9E605789-09D0-4960-8BC1-3EFD8753FE84?>
  <?define OtherUpgradeCode = 703FFA44-28B3-48C3-AB59-2D180F83AAD9?>
  <?define Serves = HTTP, HTTPS, S3 and an OCI registry?>
<?else?>
  <?error Product is go-fs or go-fs-light?>
<?endif?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">
  <Package Name="$(Product)"
           Manufacturer="Sven Beisiegel"
           Version="$(Version)"
           UpgradeCode="$(UpgradeCode)"
           Scope="perMachine"
           Compressed="yes">
    <SummaryInformation Description="$(Product) file server" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of $(Product) is already installed." />
    <!-- the other product, in any version, is removed along with an older
         version of this one: both install the same files and service -->
    <Upgrade Code="$(OtherUpgradeCode)">
      <UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes" OnlyDetect="no"
                      Property="OTHERPRODUCTFOUND" />
    </Upgrade>
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/svenbeisiegel/go-fs" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- 1 lets go-fs.exe through the Windows firewall on every port. Off by
         default: as installed, every server listens on 127.0.0.1 alone. -->
    <Property Id="FIREWALL" Value="0" Secure="yes" />

    <!-- The dialogs: WixUI_Minimal without its license page, so welcome,
         ready to install, progress and finish, and on a repair or removal
         from Apps the maintenance pages. The finish page of an install asks
         whether to open the admin interface, which the service started by
         then serves; the custom action opens the URL with ShellExecute, so
         in the default browser, as the user who ran the installer. -->
    <UIRef Id="WixUI_Common" />
    <UI Id="GoFsUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="NOT Installed OR PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="1" Condition="NOT Installed OR PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="OpenAdminInterface" Order="1"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
    </UI>
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open Admin interface now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="http://localhost:8080/?go-fs=admin" />
    <!-- a browser that does not open is no reason to report the install as failed -->
    <CustomAction Id="OpenAdminInterface"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixShellExec"
                  Impersonate="yes"
                  Return="ignore" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="go-fs" />
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAFOLDER" Name="go-fs">
        <Directory Id="FILESFOLDER" Name="files" />
        <Directory Id="REGISTRYFOLDER" Name="registry" />
        <Directory Id="LOGFOLDER" Name="logs" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="$(Product)" AllowAbsent="no">
      <ComponentRef Id="Executable" />
      <ComponentRef Id="DataFolder" />
      <ComponentRef Id="FilesFolder" />
      <ComponentRef Id="RegistryFolder" />
      <ComponentRef Id="LogFolder" />
      <ComponentRef Id="Configuration" />
      <ComponentRef Id="Firewall" />
    </Feature>

    <Component Id="Executable" Directory="INSTALLFOLDER">
      <File Id="GoFsExe" Name="go-fs.exe" Source="$(Bin)" KeyPath="yes" />
      <ServiceInstall Id="Service"
                      Name="go-fs"
                      DisplayName="$(Product) file server"
                      Description="Serves $(Serves) as configured in C:\ProgramData\go-fs\go-fs.toml."
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="LocalSystem"
                      Arguments="-config &quot;[DATAFOLDER]go-fs.toml&quot; -logfile &quot;[LOGFOLDER]go-fs.log&quot;">
        <!-- a crash, and the end of the service with an error, is followed by
             a restart: that is how an update over http comes back, and a
             configuration go-fs refuses is retried, with the error in the
             log -->
        <ServiceConfig OnInstall="yes" OnReinstall="yes"
                       FailureActionsWhen="failedToStopOrReturnedError" />
        <util:ServiceConfig FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="5"
                            ResetPeriodInDays="1" />
      </ServiceInstall>
      <ServiceControl Id="ServiceControl"
                      Name="go-fs"
                      Start="install"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
      <!-- what an update over http leaves beside the executable: the
           previous binary, and a staged one a crash never applied -->
      <RemoveFile Id="RemoveOldExe" Name="go-fs.exe.old" On="uninstall" />
      <RemoveFile Id="RemoveStaged" Name=".go-fs-update-*" On="uninstall" />
    </Component>

    <!-- The configuration holds every password and key, and go-fs replaces it
         by writing a file beside it and renaming that over it, so the file
         takes its permissions from this folder: SYSTEM and Administrators
         only, inherited by everything below. Kept by an uninstall. -->
    <Component Id="DataFolder" Directory="DATAFOLDER" Guid="20B49A3D-DBEF-467A-B4CD-ADF5A59E73EC" Permanent="yes">
      <CreateFolder>
        <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
      </CreateFolder>
    </Component>
    <Component Id="FilesFolder" Directory="FILESFOLDER" Guid="D6EF36D3-4661-4B22-856F-B8BB5865AC7D" Permanent="yes">
      <CreateFolder />
    </Component>
    <!-- the folder of the container registry, which the configuration names -->
    <Component Id="RegistryFolder" Directory="REGISTRYFOLDER" Guid="0858F146-76D9-454B-B13F-F6E6C70BBAD5" Permanent="yes">
      <CreateFolder />
    </Component>
    <Component Id="LogFolder" Directory="LOGFOLDER" Guid="81CCB142-4D8E-44FC-BADC-24D4BEAF8B85" Permanent="yes">
      <CreateFolder />
    </Component>

    <!-- installed once and then left alone: an update never overwrites it,
         however it was changed, and an uninstall keeps it -->
    <Component Id="Configuration" Directory="DATAFOLDER" NeverOverwrite="yes" Permanent="yes">
      <File Id="ConfigFile" Name="go-fs.toml" Source="$(Config)" KeyPath="yes" />
    </Component>

    <Component Id="Firewall" Directory="INSTALLFOLDER" Guid="03E65786-3A1A-471B-B8B3-43024753353C" Condition="FIREWALL = 1">
      <RegistryValue Root="HKLM" Key="Software\go-fs" Name="Firewall" Type="integer" Value="1" KeyPath="yes" />
      <fw:FirewallException Id="FirewallException"
                            Name="go-fs file server"
                            Program="[#GoFsExe]"
                            Scope="any"
                            Profile="all" />
    </Component>
  </Package>
</Wix>
